{
    "version": 6,
    "configurePresets": [
        {
            "name": "default",
            "displayName": "Default Config",
            "description": "Default build configuration",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "BUILD_TESTS": "ON",
                "BUILD_EXAMPLES": "ON",
                "ENABLE_WARNINGS": "ON",
                "ENABLE_LTO": "OFF",
                "ENABLE_COVERAGE": "OFF"
            }
        },
        {
            "name": "test",
            "displayName": "Test Config",
            "description": "Debug build with tests enabled",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build-test",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "BUILD_TESTS": "ON",
                "BUILD_EXAMPLES": "OFF",
                "ENABLE_WARNINGS": "ON",
                "ENABLE_SANITIZERS": "OFF",
                "ENABLE_COVERAGE": "OFF"
            }
        },
        {
            "name": "lint",
            "displayName": "Lint Config",
            "description": "Build with clang-tidy linting",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build-lint",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "BUILD_TESTS": "ON",
                "BUILD_EXAMPLES": "OFF",
                "ENABLE_WARNINGS": "ON",
                "CMAKE_CXX_CLANG_TIDY": "clang-tidy"
            }
        },
        {
            "name": "release",
            "displayName": "Release Config",
            "description": "Optimized release build",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "BUILD_TESTS": "OFF",
                "BUILD_EXAMPLES": "OFF",
                "ENABLE_WARNINGS": "ON",
                "ENABLE_LTO": "ON",
                "ENABLE_IPO": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "configurePreset": "default",
            "jobs": "${env:NUMBER_OF_PROCESSORS}"
        },
        {
            "name": "test",
            "configurePreset": "test",
            "jobs": "${env:NUMBER_OF_PROCESSORS}"
        },
        {
            "name": "lint",
            "configurePreset": "lint",
            "jobs": "2"
        },
        {
            "name": "release",
            "configurePreset": "release",
            "jobs": "${env:NUMBER_OF_PROCESSORS}"
        }
    ],
    "testPresets": [
        {
            "name": "test",
            "configurePreset": "test",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error",
                "stopOnFailure": false
            }
        },
        {
            "name": "default",
            "configurePreset": "default",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error",
                "stopOnFailure": false
            }
        }
    ]
}