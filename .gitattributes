# Set default behavior to automatically normalize line endings
* text=auto eol=lf

# Source files
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.c text eol=lf

# Build files
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Documentation
*.md text eol=lf

# Scripts
*.sh text eol=lf
*.ps1 text eol=lf
*.bat text eol=crlf

# Windows-specific
*.sln text eol=crlf
*.vcxproj text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.svg binary
*.qrc binary
